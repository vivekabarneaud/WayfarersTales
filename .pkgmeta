# CurseForge packager: builds the release zip when a tag is pushed (v0.61.0-beta...).
# Its changelog: RELEASE_NOTES.md (only this version's notes; CHANGELOG.md keeps them all).
# Keep it in sync with .gitattributes (export-ignore): nothing for us goes to players.
package-as: WayfarersTales

manual-changelog:
  filename: RELEASE_NOTES.md
  markup-type: markdown

ignore:
  - Dev.lua
  - docs
  - tools
  - TODO.md
  - .gitattributes
  - .gitignore
  - .pkgmeta
  - RELEASE_NOTES.md
